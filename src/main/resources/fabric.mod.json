{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "This is an example description! Tell everyone what your mod is about!",
  "authors": [
    "skycatminepokie"
  ],
  "contact": {
  },
  "license": "MIT-0",
  "icon": "assets/template/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.skycatdev.TemplateMod"
    ],
    "client": [
      "com.skycatdev.TemplateModClient"
    ],
    "fabric-datagen": [
      "com.skycatdev.datagen.TemplateModDataGenerator"
    ]
  },
  "mixins": [
    "template.mixins.json",
    {
      "config": "template.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  }
}